# GENERATED by bin/tn-render. Edit templates/.config/btop/btop.conf.in.
color_theme = "tokyo-night"
# theme_background=False makes btop use the TERMINAL's background instead of
# painting its own. Without it, launching btop makes the window visibly snap
# from 0.93-transparent to opaque. Same rule as fzf's bg:-1.
theme_background = False
truecolor = True
rounded_corners = True
vim_keys = True
update_ms = 1000
proc_sorting = "cpu lazy"
proc_tree = False
