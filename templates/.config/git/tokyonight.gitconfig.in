# GENERATED by bin/tn-render. Edit templates/.config/git/tokyonight.gitconfig.in.
# Pulled into ~/.gitconfig via [include], so your identity and other settings
# there are never touched by the renderer.
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    # Reads bat's theme cache, so ONE .tmTheme drives both bat and delta.
    syntax-theme = tokyonight_night
    plus-style          = "syntax ${TN_DIFF_ADD_HASH}"
    minus-style         = "syntax ${TN_DIFF_DEL_HASH}"
    plus-emph-style     = "syntax ${TN_DIFF_ADD_EMPH_HASH}"
    minus-emph-style    = "syntax ${TN_DIFF_DEL_EMPH_HASH}"
    line-numbers-plus-style  = "${TN_GREEN_HASH}"
    line-numbers-minus-style = "${TN_RED_HASH}"
    line-numbers-zero-style  = "${TN_BORDER_HASH}"
    file-style               = "${TN_BLUE_HASH}"
    file-decoration-style    = "${TN_BORDER_HASH} ul"
    hunk-header-style            = "file line-number syntax"
    hunk-header-decoration-style = "${TN_BORDER_HASH} box"
    # Quoted: an unquoted # starts a COMMENT in gitconfig, which silently
    # renders this option empty and makes delta refuse to start.
    blame-palette = "${TN_BG_HASH} ${TN_BG_ALT_HASH} ${TN_BG_HL_HASH} ${TN_BORDER_HASH}"
[merge]
    conflictstyle = zdiff3
[diff]
    colorMoved = default
