# kitty — Tokyo Night
# GENERATED by bin/tn-render from palette/tokyonight.sh. Do not edit directly;
# edit templates/.config/kitty/kitty.conf.in and re-run tn-render.

# --- font ---------------------------------------------------------------
# Use the plain "Nerd Font" family, NOT "Nerd Font Mono" (icons squeezed into
# one cell) and NOT "Propo" (proportional). kitty handles wide glyphs properly.
font_family      ${TN_FONT}
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        ${TN_FONT_SIZE}

# Ligatures on — the whole reason kitty was chosen over Konsole/Alacritty/foot.
# "cursor" would disable them only under the cursor; we want them always.
disable_ligatures never

# The .hyper.js lineHeight of 1.2. Generous leading is a large part of why the
# macOS setup looks good; this is not a detail to drop.
modify_font cell_height ${TN_LINE_HEIGHT}%

# Linux renders thinner stems than macOS, which is what people actually mean
# when they say "Linux fonts look worse". This is kitty's supported, terminal-
# scoped analogue of stem darkening: <gamma_adjustment> <contrast>.
# Comment this line out to A/B against the default.
text_composition_strategy 1.7 30

# --- window -------------------------------------------------------------
background_opacity         ${TN_OPACITY}
dynamic_background_opacity yes
window_padding_width       ${TN_PAD_V} ${TN_PAD_H}
confirm_os_window_close    0

# Wayland-native, and paint the titlebar with the terminal background so kitty
# matches Dolphin once the KDE colour scheme lands. This single line does most
# of the work of "the terminal doesn't look like a stranger on the desktop".
linux_display_server   wayland
wayland_titlebar_color background

# NOTE: background_blur is deliberately NOT set. Plasma 6.7 dropped
# org_kde_kwin_blur_manager and kitty has not implemented the replacement, so
# it would silently no-op. At 0.93 opacity you are compositing 7% of what is
# behind the window; blur is a low-pass filter on that 7% and is perceptually
# irrelevant above ~0.85. Konsole is the fallback if blur ever matters.

# --- cursor -------------------------------------------------------------
cursor                     ${TN_CURSOR_HASH}
cursor_text_color          ${TN_CURSOR_TEXT_HASH}
cursor_shape               block
cursor_blink_interval      0.5
cursor_stop_blinking_after 0

# --- colours ------------------------------------------------------------
background            ${TN_BG_HASH}
foreground            ${TN_FG_HASH}
selection_background  ${TN_SEL_HASH}
selection_foreground  none
url_color             ${TN_CYAN_HASH}

# 16-colour ANSI. Brights 9-14 are identical to 1-6 by design (stock Tokyo
# Night) — if a swatch test shows them differing, something re-themed them.
color0  ${TN_BLACK_HASH}
color8  ${TN_BRBLACK_HASH}
color1  ${TN_RED_HASH}
color9  ${TN_BRRED_HASH}
color2  ${TN_GREEN_HASH}
color10 ${TN_BRGREEN_HASH}
color3  ${TN_YELLOW_HASH}
color11 ${TN_BRYELLOW_HASH}
color4  ${TN_BLUE_HASH}
color12 ${TN_BRBLUE_HASH}
color5  ${TN_MAGENTA_HASH}
color13 ${TN_BRMAGENTA_HASH}
color6  ${TN_CYAN_HASH}
color14 ${TN_BRCYAN_HASH}
color7  ${TN_WHITE_HASH}
color15 ${TN_BRWHITE_HASH}

# --- tabs ---------------------------------------------------------------
tab_bar_edge            top
tab_bar_style           powerline
tab_powerline_style     slanted
active_tab_foreground   ${TN_BG_HASH}
active_tab_background   ${TN_BLUE_HASH}
active_tab_font_style   bold
inactive_tab_foreground ${TN_COMMENT_HASH}
inactive_tab_background ${TN_BG_ALT_HASH}

# --- borders ------------------------------------------------------------
active_border_color   ${TN_BLUE_HASH}
inactive_border_color ${TN_BORDER_HASH}
window_border_width   1pt

# --- behaviour ----------------------------------------------------------
scrollback_lines     10000
copy_on_select       no
strip_trailing_spaces smart
enable_audio_bell    no
visual_bell_duration 0.0
shell_integration    enabled
