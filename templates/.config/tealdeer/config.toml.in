# GENERATED by bin/tn-render. Edit templates/.config/tealdeer/config.toml.in.
[display]
compact = false
use_pager = false

[style.command_name]
foreground = { rgb = { r = ${TN_BLUE_R}, g = ${TN_BLUE_G}, b = ${TN_BLUE_B} } }

[style.example_text]
foreground = { rgb = { r = ${TN_FG_R}, g = ${TN_FG_G}, b = ${TN_FG_B} } }

[style.example_code]
foreground = { rgb = { r = ${TN_GREEN_R}, g = ${TN_GREEN_G}, b = ${TN_GREEN_B} } }

[style.example_variable]
foreground = { rgb = { r = ${TN_MAGENTA_R}, g = ${TN_MAGENTA_G}, b = ${TN_MAGENTA_B} } }
italic = true

[style.description]
foreground = { rgb = { r = ${TN_COMMENT_R}, g = ${TN_COMMENT_G}, b = ${TN_COMMENT_B} } }
