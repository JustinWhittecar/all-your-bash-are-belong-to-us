# GENERATED by bin/tn-render. Edit templates/.config/tmux/tmux.conf.in.
set  -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-kitty:RGB"
set -ga terminal-overrides ",*:Tc"
# Lets kitty's graphics protocol (image previews) survive inside tmux.
set  -g allow-passthrough on

set  -g mouse on
set  -g base-index 1
setw -g pane-base-index 1
set  -g escape-time 10
set  -g history-limit 50000
set  -g status-position top

# bg=default keeps the status bar transparent along with the terminal.
set  -g status-style "bg=default,fg=${TN_FG_HASH}"
set  -g status-left  "#[fg=${TN_BLUE_HASH},bold] #S #[default]"
set  -g status-right "#[fg=${TN_COMMENT_HASH}]%Y-%m-%d #[fg=${TN_BLUE_HASH}]%I:%M %p "
set  -g status-left-length 30

setw -g window-status-current-format "#[fg=${TN_BG_HASH},bg=${TN_BLUE_HASH},bold] #I:#W "
setw -g window-status-format         "#[fg=${TN_COMMENT_HASH}] #I:#W "

set  -g pane-border-style        "fg=${TN_BORDER_HASH}"
set  -g pane-active-border-style "fg=${TN_BLUE_HASH}"
set  -g message-style            "bg=${TN_BG_ALT_HASH},fg=${TN_FG_HASH}"
set  -g mode-style               "bg=${TN_SEL_HASH},fg=${TN_BRWHITE_HASH}"
