# Tokyo Night colours for fzf. POSIX — sourced by both bash and zsh.
# GENERATED by bin/tn-render. Edit templates/.config/tokyonight/fzf.sh.in.
#
# THE IMPORTANT PART: bg, gutter and preview-bg are `-1`, meaning "terminal
# default", NOT the literal ${TN_BG_HASH}. Hardcoding the background paints an
# OPAQUE rectangle inside a 0.93-transparent terminal — the fzf pane visibly
# stops being see-through while everything around it still is. `-1` inherits
# the transparency. Same rule applies to btop, tmux and nvim.
# bg+ (the selected line) IS a real colour; that one should be solid.

export FZF_DEFAULT_OPTS="
--color=fg:${TN_FG_HASH},fg+:${TN_BRWHITE_HASH},bg:-1,bg+:${TN_SEL_HASH}
--color=hl:${TN_CYAN_HASH},hl+:${TN_CYAN_HASH},info:${TN_COMMENT_HASH},marker:${TN_GREEN_HASH}
--color=prompt:${TN_BLUE_HASH},spinner:${TN_MAGENTA_HASH},pointer:${TN_MAGENTA_HASH}
--color=header:${TN_GREEN_HASH},border:${TN_COMMENT_HASH},label:${TN_FG_HASH},query:${TN_BRWHITE_HASH}
--color=gutter:-1,preview-bg:-1
--height 40% --layout=reverse --border=rounded --info=inline
"
