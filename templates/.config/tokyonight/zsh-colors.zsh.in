# Tokyo Night colours for zsh-syntax-highlighting and zsh-autosuggestions.
# GENERATED by bin/tn-render. Edit templates/.config/tokyonight/zsh-colors.zsh.in.
#
# You look at this more than any other themed surface — it colours the command
# line live as you type — so it is worth getting right rather than leaving at
# the defaults, which are hardcoded ANSI and clash badly with Tokyo Night.

# The ghost text of an autosuggestion. Must be dim enough to read as "not typed
# yet" but legible: the comment colour is exactly that role.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=${TN_COMMENT_HASH}"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=${TN_RED_HASH},bold'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=${TN_MAGENTA_HASH}'
ZSH_HIGHLIGHT_STYLES[alias]='fg=${TN_GREEN_HASH}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=${TN_GREEN_HASH}'
ZSH_HIGHLIGHT_STYLES[function]='fg=${TN_GREEN_HASH}'
ZSH_HIGHLIGHT_STYLES[command]='fg=${TN_GREEN_HASH}'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=${TN_GREEN_HASH},italic'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=${TN_BRBLACK_HASH}'
ZSH_HIGHLIGHT_STYLES[path]='fg=${TN_BLUE_HASH},underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=${TN_CYAN_HASH}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=${TN_YELLOW_HASH}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=${TN_YELLOW_HASH}'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=${TN_YELLOW_HASH}'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=${TN_MAGENTA_HASH}'
ZSH_HIGHLIGHT_STYLES[comment]='fg=${TN_COMMENT_HASH},italic'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=${TN_CYAN_HASH}'
ZSH_HIGHLIGHT_STYLES[arg0]='fg=${TN_GREEN_HASH}'
ZSH_HIGHLIGHT_STYLES[default]='fg=${TN_FG_HASH}'
