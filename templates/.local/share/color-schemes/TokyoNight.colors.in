[General]
ColorScheme=TokyoNight
Name=Tokyo Night
shadeSortColumn=true

[KDE]
contrast=4
frameContrast=0.2

[ColorEffects:Disabled]
Color=${TN_BG_ALT_RGB}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=${TN_BG_ALT_RGB}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Window]
BackgroundNormal=${TN_BG_RGB}
BackgroundAlternate=${TN_BG_ALT_RGB}
ForegroundNormal=${TN_FG_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BLUE_RGB}
ForegroundLink=${TN_BLUE_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

[Colors:View]
BackgroundNormal=${TN_BG_DARK_RGB}
BackgroundAlternate=${TN_BG_RGB}
ForegroundNormal=${TN_FG_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BLUE_RGB}
ForegroundLink=${TN_BLUE_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

[Colors:Button]
BackgroundNormal=${TN_BG_HL_RGB}
BackgroundAlternate=${TN_BG_ALT_RGB}
ForegroundNormal=${TN_FG_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BLUE_RGB}
ForegroundLink=${TN_BLUE_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

[Colors:Selection]
BackgroundNormal=${TN_SEL_RGB}
BackgroundAlternate=${TN_SEL_RGB}
ForegroundNormal=${TN_BRWHITE_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BRWHITE_RGB}
ForegroundLink=${TN_CYAN_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

[Colors:Tooltip]
BackgroundNormal=${TN_BG_DARK_RGB}
BackgroundAlternate=${TN_BG_RGB}
ForegroundNormal=${TN_FG_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BLUE_RGB}
ForegroundLink=${TN_BLUE_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

[Colors:Complementary]
BackgroundNormal=${TN_BG_RGB}
BackgroundAlternate=${TN_BG_ALT_RGB}
ForegroundNormal=${TN_FG_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BLUE_RGB}
ForegroundLink=${TN_BLUE_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

# Header is what Plasma 6 uses for titlebar-adjacent header areas.
[Colors:Header]
BackgroundNormal=${TN_BG_RGB}
BackgroundAlternate=${TN_BG_ALT_RGB}
ForegroundNormal=${TN_FG_RGB}
ForegroundInactive=${TN_COMMENT_RGB}
ForegroundActive=${TN_BLUE_RGB}
ForegroundLink=${TN_BLUE_RGB}
ForegroundVisited=${TN_MAGENTA_RGB}
ForegroundNegative=${TN_RED_RGB}
ForegroundNeutral=${TN_YELLOW_RGB}
ForegroundPositive=${TN_GREEN_RGB}
DecorationFocus=${TN_BLUE_RGB}
DecorationHover=${TN_BLUE_RGB}

[Colors:Header][Inactive]
BackgroundNormal=${TN_BG_DARK_RGB}
BackgroundAlternate=${TN_BG_RGB}
ForegroundNormal=${TN_COMMENT_RGB}

# [WM] is what colours the window TITLEBAR. This is the group that makes kitty's
# CSD titlebar and Dolphin's titlebar the same colour — i.e. the single reason
# the terminal stops looking like a stranger on the desktop.
[WM]
activeBackground=${TN_BG_RGB}
activeForeground=${TN_BRWHITE_RGB}
activeBlend=${TN_FG_RGB}
inactiveBackground=${TN_BG_DARK_RGB}
inactiveForeground=${TN_COMMENT_RGB}
inactiveBlend=${TN_COMMENT_RGB}
