# GENERATED by bin/tn-render. Konsole uses DECIMAL rgb, not hex.
# Konsole is the FALLBACK terminal: it gets real blur and transparency natively
# on Plasma 6.7 (kitty does not), but has no ligature support (KDE bug 361659).
[General]
Description=Tokyo Night
Opacity=${TN_OPACITY}
Wallpaper=
Blur=true

[Background]
Color=${TN_BG_RGB}
[BackgroundIntense]
Color=${TN_BG_DARK_RGB}
[Foreground]
Color=${TN_FG_RGB}
[ForegroundIntense]
Color=${TN_BRWHITE_RGB}
Bold=true

# Intense values repeat 1-6 deliberately: brights 9-14 are identical to 1-6
# in stock Tokyo Night.
[Color0]
Color=${TN_BLACK_RGB}
[Color0Intense]
Color=${TN_BRBLACK_RGB}
[Color1]
Color=${TN_RED_RGB}
[Color1Intense]
Color=${TN_BRRED_RGB}
[Color2]
Color=${TN_GREEN_RGB}
[Color2Intense]
Color=${TN_BRGREEN_RGB}
[Color3]
Color=${TN_YELLOW_RGB}
[Color3Intense]
Color=${TN_BRYELLOW_RGB}
[Color4]
Color=${TN_BLUE_RGB}
[Color4Intense]
Color=${TN_BRBLUE_RGB}
[Color5]
Color=${TN_MAGENTA_RGB}
[Color5Intense]
Color=${TN_BRMAGENTA_RGB}
[Color6]
Color=${TN_CYAN_RGB}
[Color6Intense]
Color=${TN_BRCYAN_RGB}
[Color7]
Color=${TN_WHITE_RGB}
[Color7Intense]
Color=${TN_BRWHITE_RGB}
